{
  "name": "CharacterReferenceImage",
  "type": "object",
  "properties": {
    "character_id": {
      "type": "string",
      "description": "Reference to Character entity"
    },
    "image_url": {
      "type": "string",
      "description": "URL of the uploaded reference image"
    },
    "image_type": {
      "type": "string",
      "enum": [
        "face",
        "full_body",
        "pose",
        "style"
      ],
      "default": "face",
      "description": "Type of reference"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Whether this image should be used in generation"
    }
  },
  "required": [
    "character_id",
    "image_url"
  ]
}